# Copy to `.env` (or export these in your shell) before running the backend.
#
#   set -a; source .env; set +a; dart run bin/server.dart      # bash
#   Get-Content .env | ForEach-Object { ... }                  # PowerShell: simplest is
#   $env:GEMINI_API_KEY="..."; dart run bin/server.dart

# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides:
GEMINI_MODEL=gemini-2.5-flash
PORT=8080
CACHE_DB_PATH=./data/flyball_cache.db
# Accounts + login sessions — unlike the cache, don't delete this one.
USER_DB_PATH=./data/flyball_users.db
